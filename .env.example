# ────────────────────────────────────────────────────────────────
# CLOUDZ™ — Environment variables
# Copy this file to `.env.local` and fill in the values you need.
# All integrations are currently stubbed; these are placeholders
# so the wiring is ready when the real services are connected.
# ────────────────────────────────────────────────────────────────

# Public site URL (used for SEO / canonical URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Minecraft server (status API — see services/minecraft.ts)
NEXT_PUBLIC_MC_SERVER_IP=play.cloudzsociety.net
NEXT_PUBLIC_MC_SERVER_PORT=25565

# Discord (invite + widget API — see services/discord.ts)
NEXT_PUBLIC_DISCORD_INVITE=https://discord.gg/cloudz
DISCORD_GUILD_ID=
DISCORD_BOT_TOKEN=

# External wiki (GitBook) — see services/wiki.ts
NEXT_PUBLIC_WIKI_URL=https://docs.cloudzsociety.net

# Shop backend (Tebex or custom — see services/shop.ts)
SHOP_PROVIDER=mock
TEBEX_SECRET=
TEBEX_STORE_ID=

# Auth / database (reserved for later — see services/auth.ts, services/database.ts)
DATABASE_URL=
AUTH_SECRET=

# Admin dashboard (/admin) — password to log in and edit content.
# Change this before using the panel! Default (local only): cloudz-admin
ADMIN_PASSWORD=cloudz-admin
